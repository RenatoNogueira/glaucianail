PORT=3000
SESSION_SECRET=troque-este-segredo
ADMIN_USER=admin
ADMIN_PASS=troque-esta-senha
STUDIO_NAME=Studio Manicure & Pedicure
# Opcional: envio automatico via WhatsApp Cloud API (Meta).
# Sem isso, o painel admin abre o WhatsApp com a mensagem pronta (link wa.me).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Pasta dos dados (padrão: ./data). Recomendado: um caminho FORA do projeto, para sobreviver a atualizações.
# DATA_DIR=C:\dados-agenda

# ---- Produção / Vercel ----
# Em produção (NODE_ENV=production ou Vercel) ADMIN_PASS (>=8) e SESSION_SECRET (>=16) são OBRIGATÓRIOS.
# Banco: API do Supabase (recomendado). Rode supabase/schema.sql no SQL Editor uma vez.
# A chave SECRETA fica só no servidor (nunca no navegador/repositório). SUPABASE_PUBLISHABLE_KEY e SUPABASE_JWKS_URL não são usadas.
# SUPABASE_URL=https://SEU-REF.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...
# Alternativa: Postgres direto pelo "Transaction pooler" (porta 6543). Tem prioridade sobre a API.
# DATABASE_URL=postgresql://postgres.SEU_REF:SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres
# DATABASE_SSL_CA=
# Fuso do estúdio (servidores da Vercel rodam em UTC)
# TZ_NAME=America/Sao_Paulo
# Domínios extras permitidos a enviar dados ao sistema (separe por vírgula)
# ALLOWED_ORIGINS=
